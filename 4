def run_time_series(net, depot_charge_dict, base_profile_df):
    """Run the hourly power flow with base freight and EV charging loads."""
    time_index = prices_df.index
    n_hours = len(time_index)

    if len(base_profile_df) < n_hours:
        raise ValueError(
            f"Freight profile has {len(base_profile_df)} rows, "
            f"but the simulation needs {n_hours} hours."
        )

    vm = pd.DataFrame(index=time_index, columns=net.bus.index, dtype=float)
    load = pd.DataFrame(index=time_index, columns=net.line.index, dtype=float)
    trafo = pd.DataFrame(index=time_index, columns=net.trafo.index, dtype=float)

    net_ev = copy.deepcopy(net)

    # Find existing base loads or create them on the copied network.
    base_load_idx = {}
    for depot, bus in depot_bus_map.items():
        existing = net_ev.load.index[
            net_ev.load["name"].astype(str).isin([f"depot_{depot}", f"Depot {depot}"])
        ]
        if len(existing) > 0:
            base_load_idx[depot] = existing[0]
        else:
            base_load_idx[depot] = pp.create_load(
                net_ev, bus=bus, p_mw=0.0, q_mvar=0.0, name=f"Depot {depot}"
            )

    # Add one EV load per depot.
    ev_load_idx = {}
    for depot, bus in depot_bus_map.items():
        ev_load_idx[depot] = pp.create_load(
            net_ev, bus=bus, p_mw=0.0, q_mvar=0.0, name=f"EV_{depot}"
        )

    for i, timestamp in enumerate(time_index):
        # Update base freight loads (kW -> MW).
        for depot in DEPOTS:
            if depot in base_profile_df.columns:
                net_ev.load.at[base_load_idx[depot], "p_mw"] = (
                    base_profile_df[depot].iloc[i] / 1000.0
                )

        # Update EV loads (kW -> MW).
        for depot in DEPOTS:
            net_ev.load.at[ev_load_idx[depot], "p_mw"] = (
                depot_charge_dict[depot][i] / 1000.0
            )

        try:
            pp.runpp(net_ev, verbose=False)
            vm.loc[timestamp] = net_ev.res_bus["vm_pu"].values
            load.loc[timestamp] = net_ev.res_line["loading_percent"].values
            trafo.loc[timestamp] = net_ev.res_trafo["loading_percent"].values
        except Exception as error:
            print(f"  Power flow failed at {timestamp}: {error}")

    return vm, load, trafo

