# ---------- STEP 4.4: COST SAVINGS vs UNCONTROLLED ----------
price_series = prices_df["price_SEK_per_kWh"].to_numpy()

print(f"Mean market price: {price_series.mean():.4f} SEK/kWh\n")
print(f"{'Depot':<12}{'Optimised (SEK)':>18}{'Uncontrolled (SEK)':>22}"
      f"{'Savings (SEK)':>18}{'Savings %':>12}")
print("-" * 82)

total_opt = 0.0
total_unc = 0.0
for depot in DEPOTS:
    opt_cost = results[depot]["total_cost"]
    unc_profile = np.asarray(uncontrolled_profiles[depot], dtype=float)
    if len(unc_profile) != len(price_series):
        raise ValueError(
            f"{depot}: uncontrolled profile has {len(unc_profile)} hours, "
            f"but prices have {len(price_series)} hours."
        )
    unc_cost = float(np.dot(unc_profile, price_series))
    savings = unc_cost - opt_cost
    pct = 100 * savings / unc_cost if unc_cost > 0 else 0.0
    print(f"{depot:<12}{opt_cost:>18,.2f}{unc_cost:>22,.2f}"
          f"{savings:>18,.2f}{pct:>11.1f}%")
    total_opt += opt_cost
    total_unc += unc_cost

print("-" * 82)
total_savings = total_unc - total_opt
total_pct = 100 * total_savings / total_unc if total_unc > 0 else 0.0
print(f"{'TOTAL':<12}{total_opt:>18,.2f}{total_unc:>22,.2f}"
      f"{total_savings:>18,.2f}{total_pct:>11.1f}%")
print()
