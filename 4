        max_power_day = schedule["charger_kw"].iloc[start:end].reset_index(drop=True)
        energy_need   = schedule["consumption_kwh"].iloc[start:end].sum()

        charge_all.extend(uncontrolled_charging_day(avail_day, max_power_day, energy_need))

