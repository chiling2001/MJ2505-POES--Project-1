# ---------- UNCONTROLLED (DUMB) CHARGING BASELINE ----------
def uncontrolled_charging_day(avail_day, max_power_day, energy_need_kwh):
    """
    Simulate uncontrolled charging over 24 hours:
    - Charge at max available power whenever at depot
    - Stop charging once the daily energy need is met
    """
    charge = [0.0] * len(avail_day)
    remaining = energy_need_kwh

    for t in range(len(avail_day)):
        if avail_day.iloc[t] == 1 and remaining > 0:
            p = min(max_power_day.iloc[t], remaining)  # kW for 1 hour = kWh
            charge[t] = p
            remaining -= p
        if remaining <= 0:
            break  # stop charging once the day's need is met

    return charge

