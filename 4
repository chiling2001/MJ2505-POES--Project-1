# ---------- VIOLATION CHECKS ----------
def check_violations(vm, load, trafo, label):
    print(f"\n=== {label} ===")
    v_min = vm.min(axis=1)
    v_max = vm.max(axis=1)
    l_max = load.max(axis=1)
    t_max = trafo.max(axis=1)

    v_lo = (v_min < 0.9).sum()
    v_hi = (v_max > 1.1).sum()
    l_ov = (l_max > 100).sum()
    t_ov = (t_max > 100).sum()

    print(f"  Hours with voltage < 0.9 pu : {v_lo}")
    print(f"  Hours with voltage > 1.1 pu : {v_hi}")
    print(f"  Hours with line loading >100%: {l_ov}")
    print(f"  Hours with trafo loading >100%: {t_ov}")

    print(f"\n  Min bus voltage   : {v_min.min():.4f} pu")
    print(f"  Max bus voltage   : {v_max.max():.4f} pu")
    print(f"  Max line loading  : {l_max.max():.1f} %")
    print(f"  Max trafo loading : {t_max.max():.1f} %")

    return {
        "v_min": v_min.min(), "v_max": v_max.max(),
        "l_max": l_max.max(), "t_max": t_max.max(),
        "v_lo_hours": v_lo, "v_hi_hours": v_hi,
        "l_ov_hours": l_ov, "t_ov_hours": t_ov,
    }

