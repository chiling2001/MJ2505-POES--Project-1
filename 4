# ---------- PuLP OPTIMISATION (per depot, per day) ----------
def optimise_day(depot_name, day_idx, prices_day, avail_day, max_power_day, energy_need_kwh):
    model = pl.LpProblem(f"CostMin_{depot_name}_day{day_idx}", pl.LpMinimize)
    charge = pl.LpVariable.dicts("charge", range(T), lowBound=0, cat="Continuous")
    cum_energy = pl.LpVariable.dicts("cum_energy", range(T), lowBound=0, cat="Continuous")

    for t in range(T):
        model += charge[t] <= max_power_day.iloc[t] * avail_day.iloc[t]
        if t == 0:
            model += cum_energy[t] == charge[t]
        else:
            model += cum_energy[t] == cum_energy[t - 1] + charge[t]

    avail_indices = [t for t in range(T) if avail_day.iloc[t] == 1]
    if not avail_indices:
        return [0.0] * T, 0.0, "NoAvailability"

    model += cum_energy[max(avail_indices)] == energy_need_kwh
    model += pl.lpSum(charge[t] * prices_day.iloc[t] for t in range(T))
    model.solve(pl.PULP_CBC_CMD(msg=False))

    if pl.LpStatus[model.status] == "Optimal":
        return ([charge[t].varValue for t in range(T)],
                pl.value(model.objective), "Optimal")
    return [0.0] * T, 0.0, pl.LpStatus[model.status]

