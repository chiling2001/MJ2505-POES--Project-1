        float(optimised_profiles[depot][i]) / 1000.0

pp.runpp(net_cont, verbose=False)
print(f"\nBase case at worst hour (no contingency):")
print(f"  Min voltage      : {net_cont.res_bus['vm_pu'].min():.4f} pu")
print(f"  Max line loading : {net_cont.res_line['loading_percent'].max():.1f}%")
print(f"  Max trafo loading: {net_cont.res_trafo['loading_percent'].max():.1f}%")

# N-1 contingency (exclude switch lines 12, 13, 14)
test_lines = [l for l in net_cont.line.index if l not in [12, 13, 14]]
print(f"\nTesting {len(test_lines)} lines (excluding switch lines 12, 13, 14)")

violations = []
for line_out in test_lines:
    net_cont.line.at[line_out, "in_service"] = False
    unsupplied = pp.topology.unsupplied_buses(net_cont)

    if len(unsupplied) > 0:
        violations.append({"line_out": line_out, "type": "unsupplied",
                           "detail": f"{len(unsupplied)} buses"})
    else:
        try:
            pp.runpp(net_cont, verbose=False)
            for b, v in net_cont.res_bus["vm_pu"].items():
                if v < 0.9 or v > 1.1:
                    violations.append({"line_out": line_out, "type": "voltage",
                                       "detail": f"Bus {b}: {v:.4f} pu"})
            for l, ld in net_cont.res_line["loading_percent"].items():
                if ld > 100:
                    violations.append({"line_out": line_out, "type": "line_overload",
                                       "detail": f"Line {l}: {ld:.1f}%"})
            for t, ld in net_cont.res_trafo["loading_percent"].items():
                if ld > 100:
                    violations.append({"line_out": line_out, "type": "trafo_overload",
                                       "detail": f"Trafo {t}: {ld:.1f}%"})
        except Exception as e:
            violations.append({"line_out": line_out, "type": "failed", "detail": str(e)})
    net_cont.line.at[line_out, "in_service"] = True

viol_df = pd.DataFrame(violations)
print(f"\nTotal contingency violations: {len(viol_df)}")
if len(viol_df) > 0:
    print("\nBreakdown by type:")
    print(viol_df["type"].value_counts())
    print(f"\nCritical lines: {sorted(viol_df['line_out'].unique())}")
    print("\nFirst 30 violations:")
    display(viol_df.head(30))
else:
    print("✅ No violations — N-1 secure at worst-case hour.")

# ---------- DIAGNOSTIC: Contingency WITHOUT EV loads ----------
net_no_ev = copy.deepcopy(net_base)
# Add EV loads but keep them at zero
for depot, bus in depot_bus_map.items():
    pp.create_load(net_no_ev, bus=bus, p_mw=0.0, q_mvar=0.0, name=f"EV_{depot}")

# Set depot base loads at worst hour
for depot in DEPOTS:
    if depot in freight_profiles.columns:
        net_no_ev.load.at[depot_load_idx[depot], "p_mw"] = \
            float(freight_profiles[depot].iloc[i]) / 1000.0

# N-1 contingency without EV
violations_no_ev = []
for line_out in test_lines:
    net_no_ev.line.at[line_out, "in_service"] = False
    try:
        pp.runpp(net_no_ev, verbose=False)
        for l, ld in net_no_ev.res_line["loading_percent"].items():
            if ld > 100:
                violations_no_ev.append({"line_out": line_out, "type": "line_overload",
                                          "detail": f"Line {l}: {ld:.1f}%"})
    except:
        pass
    net_no_ev.line.at[line_out, "in_service"] = True

print(f"Violations WITHOUT EV loads: {len(violations_no_ev)}")
print(f"Violations WITH EV loads   : {len(viol_df)}")
print()
if len(violations_no_ev) == len(viol_df):
    print("✅ Same violations with/without EV — the N-1 issue is inherent to the network.")
else:
    print(f"⚠️ EV adds {len(viol_df) - len(violations_no_ev)} additional violations.")

