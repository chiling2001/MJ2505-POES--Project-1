# ---------- LOAD eFleetPlan SCHEDULES ----------
def schedule_path(depot):
    candidates = [
        SCHEDULE_DIR / f"schedule_{depot}" / f"schedule_{depot}.csv",
        SCHEDULE_DIR / f"schedule_{depot}.csv",
        INPUT_DIR / f"schedule_{depot}.csv",
        INPUT_DIR / f"{depot}_depot.csv",
    ]
    for path in candidates:
        if path.exists():
            return path
    raise FileNotFoundError(
        f"No schedule CSV found for {depot}. Tried: "
        + ", ".join(str(path) for path in candidates)
    )


def load_depot_schedule(depot):
    csv_path = schedule_path(depot)
    df = pd.read_csv(csv_path)
    print(f"\n--- {depot} schedule: {csv_path} ---")
    print("Columns:", list(df.columns))

    date_col = next((c for c in ["date", "Date", "datetime", "timestamp", "Time"]
                     if c in df.columns), None)
    cons_col = next((c for c in ["Consumption_kWh", "Consumption_kwh", "consumption_kwh",
                                 "Consumption", "energy_kwh"] if c in df.columns), None)
    avail_col = next((c for c in ["ChargingStation", "Location", "at_depot", "AtDepot"]
                      if c in df.columns), None)
    power_col = next((c for c in ["PowerRating_kW", "PowerRating_kw", "ChargerPower",
                                  "charger_kw", "Power_kW"] if c in df.columns), None)
    if date_col is None:
        raise ValueError(f"{depot}: no date column found.")
    if cons_col is None:
        raise ValueError(f"{depot}: no consumption column found.")
    if avail_col is None:
        raise ValueError(f"{depot}: no availability column found.")

    df[date_col] = pd.to_datetime(df[date_col])
    df = df.rename(columns={date_col: "date", cons_col: "consumption_kwh", avail_col: "at_depot"})
    if power_col is not None:
        df = df.rename(columns={power_col: "charger_kw"})
    else:
        df["charger_kw"] = CHARGER_POWER_KW[depot]

    return df.groupby("date").agg(
        consumption_kwh=("consumption_kwh", "sum"),
        at_depot=("at_depot", "max"),
        charger_kw=("charger_kw", "sum"),
    ).sort_index()

