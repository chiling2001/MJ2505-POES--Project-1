def run_step3_n1(net, lines_to_test, v_min_limit, v_max_limit, loading_limit):
    results = []
    for line_index in lines_to_test:
        line_idx_int = int(line_index)
        line_name = net.line.loc[line_idx_int, "name"]
        nminus1_cases = {"line": {"index": np.array([line_idx_int])}}
        try:
            res = pp.contingency.run_contingency(
                net, nminus1_cases,
                pf_options={"numba": False},
                pf_options_nminus1={"numba": False}
            )
 
            # ---- BUS: Voltage & Unsupplied Bus ----
            bus_indices = np.array(res["bus"]["index"])
            bus_min_values = np.array(res["bus"]["min_vm_pu"], dtype=float)
            bus_max_values = np.array(res["bus"]["max_vm_pu"], dtype=float)
 
            unsupplied_mask = np.isnan(bus_min_values)
            unsupplied_buses = bus_indices[unsupplied_mask].tolist()
 
            min_voltage = np.nanmin(bus_min_values) if (~unsupplied_mask).any() else np.nan
            max_voltage = np.nanmax(bus_max_values) if (~np.isnan(bus_max_values)).any() else np.nan
 
            # ---- LINE：Maximum Loading ----
            line_indices = np.array(res["line"]["index"])
            line_loading_values = np.array(res["line"]["max_loading_percent"], dtype=float)
            max_line_loading = (
                np.nanmax(line_loading_values) if (~np.isnan(line_loading_values)).any() else np.nan
            )
 
            # ---- TRANSFORMER：Maximum Loading ----
            trafo_loading_values = np.array(res["trafo"]["max_loading_percent"], dtype=float)
            max_trafo_loading = (
                np.nanmax(trafo_loading_values) if (~np.isnan(trafo_loading_values)).any() else np.nan
            )
 
            voltage_violation = (
                (pd.notna(min_voltage) and min_voltage < v_min_limit)
                or (pd.notna(max_voltage) and max_voltage > v_max_limit)
            )
            line_violation = pd.notna(max_line_loading) and max_line_loading > loading_limit
            trafo_violation = pd.notna(max_trafo_loading) and max_trafo_loading > loading_limit
 
            results.append(
                {
                    "outage_line_index": line_index,
                    "outage_line_name": line_name,
                    "min_voltage_pu": min_voltage,
                    "max_voltage_pu": max_voltage,
                    "max_line_loading_percent": max_line_loading,
                    "max_trafo_loading_percent": max_trafo_loading,
                    "unsupplied_bus_indices": unsupplied_buses,
                    "voltage_violation": voltage_violation,
                    "line_violation": line_violation,
                    "trafo_violation": trafo_violation,
                    "violation": (
                        voltage_violation
                        or line_violation
                        or trafo_violation
                        or bool(unsupplied_buses)
                    ),
                    "error": None,
                }
            )
        except Exception as error:
            results.append(
                {
                    "outage_line_index": line_index,
                    "outage_line_name": line_name,
                    "min_voltage_pu": np.nan,
                    "max_voltage_pu": np.nan,
                    "max_line_loading_percent": np.nan,
                    "max_trafo_loading_percent": np.nan,
                    "unsupplied_bus_indices": [],
                    "voltage_violation": True,
                    "line_violation": True,
                    "trafo_violation": True,
                    "violation": True,
                    "error": str(error),
                }
            )
        finally:
            net.line["in_service"] = original_line_state.copy()
    return pd.DataFrame(results)
 
 
