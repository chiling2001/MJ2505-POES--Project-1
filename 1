import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import pandapower as pp
import pandapower.networks as pn
import pandapower.contingency as pc
from IPython.display import display

pd.set_option("display.max_rows", None)
pd.set_option("display.max_columns", None)

V_MIN, V_MAX = 0.90, 1.10
LINE_LIMIT, TRAFO_LIMIT = 100.0, 100.0


def show(title, data):
    print(f"\n===== {title} =====")
    display(data)


# ============================================================
# STEP 1.1 - BASELINE NETWORK ANALYSIS
# ============================================================

# Create the CIGRE MV network without DER
net = pn.create_cigre_network_mv(with_der=False)
print("\n===== NETWORK CREATED =====")
print(net)

for element in ["bus", "line", "trafo", "load", "switch"]:
    show(f"{element.upper()} DATA", net[element])

# Run baseline AC power flow
pp.runpp(net, numba=False)
print(f"\nPower flow converged: {net.converged}")

# Collect baseline results
bus_results = net.bus[["name", "vn_kv"]].rename(columns={"name": "bus_name"}).copy()
bus_results.insert(0, "bus_index", bus_results.index)
bus_results[["vm_pu", "va_degree"]] = net.res_bus[["vm_pu", "va_degree"]]

line_results = net.line[["name", "from_bus", "to_bus"]].rename(
    columns={"name": "line_name"}
).copy()
line_results.insert(0, "line_index", line_results.index)
line_cols = ["p_from_mw", "q_from_mvar", "p_to_mw", "q_to_mvar", "loading_percent"]
line_results[line_cols] = net.res_line[line_cols]

trafo_results = net.trafo[["name", "hv_bus", "lv_bus"]].rename(
    columns={"name": "trafo_name"}
).copy()
trafo_results.insert(0, "trafo_index", trafo_results.index)
trafo_cols = ["p_hv_mw", "q_hv_mvar", "loading_percent"]
trafo_results[trafo_cols] = net.res_trafo[trafo_cols]

show("BUS VOLTAGE RESULTS", bus_results)
show("LINE RESULTS", line_results)
show("LINES SORTED BY LOADING", line_results.sort_values("loading_percent", ascending=False))
show("TRANSFORMER RESULTS", trafo_results)

# Check operating limits
voltage_violations = bus_results[
    (bus_results.vm_pu < V_MIN) | (bus_results.vm_pu > V_MAX)
]
line_violations = line_results[line_results.loading_percent > LINE_LIMIT]
trafo_violations = trafo_results[trafo_results.loading_percent > TRAFO_LIMIT]

for title, data in [
    ("VOLTAGE VIOLATIONS", voltage_violations),
    ("LINE LOADING VIOLATIONS", line_violations),
    ("TRANSFORMER LOADING > 100%", trafo_violations),
]:
    print(f"\n===== {title} =====")
    if data.empty:
        print("No violations found.")
    else:
        display(data)

# Identify baseline extremes
min_bus = bus_results.loc[bus_results.vm_pu.idxmin()]
max_bus = bus_results.loc[bus_results.vm_pu.idxmax()]
max_line = line_results.loc[line_results.loading_percent.idxmax()]
max_trafo = trafo_results.loc[trafo_results.loading_percent.idxmax()]

for title, row in [
    ("MINIMUM BUS VOLTAGE", min_bus),
    ("MAXIMUM BUS VOLTAGE", max_bus),
    ("MOST HEAVILY LOADED LINE", max_line),
    ("MOST HEAVILY LOADED TRANSFORMER", max_trafo),
]:
    show(title, row.to_frame().T)

print("\n===== STEP 1.1 BASELINE SUMMARY =====")
print(f"Power flow converged: {net.converged}")
print(f"Minimum bus voltage: {min_bus.vm_pu:.4f} pu at {min_bus.bus_name}")
print(f"Maximum bus voltage: {max_bus.vm_pu:.4f} pu at {max_bus.bus_name}")
print(f"Maximum line loading: {max_line.loading_percent:.2f}% at {max_line.line_name}")
print(f"Maximum transformer loading: {max_trafo.loading_percent:.2f}% at {max_trafo.trafo_name}")
print(f"Voltage violations: {len(voltage_violations)}")
print(f"Line loading violations: {len(line_violations)}")
print(f"Transformers above 100%: {len(trafo_violations)}")

# Plot baseline bus voltages
fig, ax = plt.subplots(figsize=(10, 5))
ax.plot(bus_results.bus_index, bus_results.vm_pu, marker="o", label="Bus voltage")
ax.axhline(V_MIN, linestyle="--", color="red", label=f"Minimum limit = {V_MIN:.2f} pu")
ax.axhline(V_MAX, linestyle="--", color="orange", label=f"Maximum limit = {V_MAX:.2f} pu")
ax.set(xlabel="Bus index", ylabel="Voltage [pu]", title="Baseline Bus Voltage Profile")
ax.grid(True)
ax.legend()
plt.tight_layout()
plt.show()

# Plot baseline line loading
fig, ax = plt.subplots(figsize=(10, 5))
ax.bar(line_results.line_index, line_results.loading_percent)
ax.axhline(LINE_LIMIT, linestyle="--", color="red", label="Maximum loading = 100%")
ax.set(xlabel="Line index", ylabel="Line loading [%]", title="Baseline Line Loading")
ax.legend()
plt.tight_layout()
plt.show()


# ============================================================
# STEP 1.2 - N-1 CONTINGENCY ANALYSIS
# ============================================================

# Set contingency limits
net.bus["min_vm_pu"], net.bus["max_vm_pu"] = V_MIN, V_MAX
net.line["max_loading_percent"] = LINE_LIMIT
net.trafo["max_loading_percent"] = TRAFO_LIMIT

# Tie-switch mapping
tie_lines = {"S1": "Line 14-8", "S2": "Line 6-7", "S3": "Line 11-4"}
tie_line_indices, tie_switch_indices = {}, {}

for switch_name, line_name in tie_lines.items():
    matches = net.line.index[net.line.name == line_name]
    if len(matches) != 1:
        raise ValueError(f"Expected one line index for {line_name}; found {len(matches)}.")
    line_index = matches[0]
    tie_line_indices[switch_name] = line_index

    matches = net.switch.index[
        (net.switch.et == "l")
        & (net.switch.element == line_index)
        & (~net.switch.closed)
    ]
    if len(matches) != 1:
        raise ValueError(f"Expected one normally open switch for {switch_name}.")
    tie_switch_indices[switch_name] = matches[0]

switch_mapping = pd.DataFrame([
    {
        "switch": name,
        "tie_line": line,
        "line_index": tie_line_indices[name],
        "switch_index": tie_switch_indices[name],
    }
    for name, line in tie_lines.items()
])
show("SWITCH MAPPING", switch_mapping)

# Store original network states
original_line_state = net.line.in_service.copy()
original_switch_state = net.switch.closed.copy()

# False = open; True = closed
switch_configs = {
    "Base": {"S1": False, "S2": False, "S3": False},
    "Config 1": {"S1": True, "S2": False, "S3": False},
    "Config 2": {"S1": False, "S2": True, "S3": False},
    "Config 3": {"S1": False, "S2": False, "S3": True},
}


def set_switch_config(config):
    net.switch["closed"] = original_switch_state.copy()
    for name, closed in config.items():
        net.switch.loc[tie_switch_indices[name], "closed"] = closed


def get_extreme(indices, values, elements, mode="max"):
    """Return the extreme value and corresponding element name."""
    if np.isnan(values).all():
        return np.nan, None
    position = np.nanargmin(values) if mode == "min" else np.nanargmax(values)
    return values[position], elements.loc[indices[position], "name"]


# Exclude the three tie lines from outage tests
contingency_lines = net.line.index[~net.line.name.isin(tie_lines.values())].tolist()
show("N-1 CONTINGENCY LINES", net.line.loc[contingency_lines, ["name", "from_bus", "to_bus"]])
print(f"Number of contingency lines: {len(contingency_lines)}")

if len(contingency_lines) != 12:
    raise ValueError("Expected 12 contingency lines.")

# Run 12 outages under each of the four configurations
all_results = []
try:
    for config_name, config in switch_configs.items():
        print(f"\n===== TESTING: {config_name} =====")
        set_switch_config(config)

        for line_index in contingency_lines:
            line_name = net.line.loc[line_index, "name"]
            case = {"configuration": config_name, "outage_line_index": line_index,
                    "outage_line": line_name}

            try:
                nminus1_cases = {"line": {"index": np.array([line_index], dtype=int)}}
                res = pc.run_contingency(
                    net, nminus1_cases,
                    pf_options={"numba": False},
                    pf_options_nminus1={"numba": False},
                )

                # Extract contingency results
                bus_indices = np.asarray(res["bus"]["index"])
                bus_min = np.asarray(res["bus"]["min_vm_pu"], dtype=float)
                bus_max = np.asarray(res["bus"]["max_vm_pu"], dtype=float)
                line_indices = np.asarray(res["line"]["index"])
                line_loading = np.asarray(res["line"]["max_loading_percent"], dtype=float)

                # Identify unsupplied buses and operating extremes
                unsupplied_mask = np.isnan(bus_min)
                unsupplied = bool(unsupplied_mask.any())
                unsupplied_names = net.bus.loc[bus_indices[unsupplied_mask], "name"].tolist()
                min_voltage, min_voltage_bus = get_extreme(bus_indices, bus_min, net.bus, "min")
                max_voltage, max_voltage_bus = get_extreme(bus_indices, bus_max, net.bus)
                max_loading, max_loading_line = get_extreme(line_indices, line_loading, net.line)

                voltage_violation = bool(min_voltage < V_MIN or max_voltage > V_MAX)
                line_violation = bool(max_loading > LINE_LIMIT)

                case.update({
                    "unsupplied": unsupplied,
                    "unsupplied_buses": ", ".join(unsupplied_names),
                    "min_voltage_pu": min_voltage,
                    "min_voltage_bus": min_voltage_bus,
                    "max_voltage_pu": max_voltage,
                    "max_voltage_bus": max_voltage_bus,
                    "max_line_loading_percent": max_loading,
                    "max_loading_line": max_loading_line,
                    "voltage_violation": voltage_violation,
                    "line_violation": line_violation,
                    "any_violation": unsupplied or voltage_violation or line_violation,
                    "error": None,
                })
            except Exception as e:
                case["error"] = str(e)

            all_results.append(case)
finally:
    # Restore the baseline network
    net.line["in_service"] = original_line_state.copy()
    net.switch["closed"] = original_switch_state.copy()

pp.runpp(net, numba=False)
print(f"\nNetwork restored: {net.converged}")

contingency_results = pd.DataFrame(all_results)

# Stop if any calculation failed
error_cases = contingency_results[contingency_results.error.notna()]
if not error_cases.empty:
    show("CALCULATION ERRORS", error_cases[["configuration", "outage_line", "error"]])
    raise RuntimeError("Calculation errors detected. Resolve them before continuing.")

show("ALL N-1 CONTINGENCY RESULTS", contingency_results.round(4))
print(f"Total contingency cases: {len(contingency_results)}")

if len(contingency_results) != 48:
    raise ValueError("Expected 48 contingency cases.")

# Rank cases by loading and minimum voltage
loading_cols = [
    "configuration", "outage_line", "max_line_loading_percent",
    "max_loading_line", "min_voltage_pu", "min_voltage_bus",
]
voltage_cols = [
    "configuration", "outage_line", "min_voltage_pu",
    "min_voltage_bus", "max_line_loading_percent", "max_loading_line",
]
worst_loading_cases = contingency_results.sort_values("max_line_loading_percent", ascending=False)
worst_voltage_cases = contingency_results.sort_values("min_voltage_pu")
show("WORST CASES BY LINE LOADING", worst_loading_cases[loading_cols].head(15).round(4))
show("WORST CASES BY BUS VOLTAGE", worst_voltage_cases[voltage_cols].head(15).round(4))


# ============================================================
# STEP 1.3 - CRITICAL LINE IDENTIFICATION
# ============================================================

# Classify violations for each outage/configuration pair
violation_cases = contingency_results[contingency_results.any_violation == True].copy()


def get_violation_reason(row):
    checks = [
        ("unsupplied", "Unsupplied bus"),
        ("voltage_violation", "Voltage violation"),
        ("line_violation", "Line overload"),
    ]
    return " + ".join(reason for column, reason in checks if row[column])


violation_cases["reason"] = [
    get_violation_reason(row) for _, row in violation_cases.iterrows()
]
violation_cols = [
    "configuration", "outage_line", "reason", "unsupplied_buses",
    "min_voltage_pu", "min_voltage_bus", "max_line_loading_percent", "max_loading_line",
]
show("VIOLATION CASES AND REASONS", violation_cases[violation_cols].round(4))

# List violating outage lines for each configuration
print("\n===== VIOLATING LINES BY CONFIGURATION =====")
for config_name in switch_configs:
    names = violation_cases.loc[
        violation_cases.configuration == config_name, "outage_line"
    ].drop_duplicates().tolist()
    print(f"\n--- {config_name} ---")
    print("\n".join(f"- {name}" for name in names) if names else "No violating lines.")

# Summarize feasible and violating configurations for each outage
line_summary_list = []
for line_index in contingency_lines:
    line_name = net.line.loc[line_index, "name"]
    cases = contingency_results[contingency_results.outage_line_index == line_index]
    violating = cases.loc[cases.any_violation == True, "configuration"].tolist()
    feasible = cases.loc[cases.any_violation == False, "configuration"].tolist()
    line_summary_list.append({
        "outage_line": line_name,
        "violating_configs": ", ".join(violating),
        "feasible_configs": ", ".join(feasible),
        "no_feasible_configuration": len(feasible) == 0,
    })

line_summary = pd.DataFrame(line_summary_list)
show("LINE CONTINGENCY SUMMARY", line_summary)

# Critical: no feasible configuration among the four tested
critical_lines = line_summary[line_summary.no_feasible_configuration].copy()
print("\n===== FINAL CRITICAL LINES =====")
if critical_lines.empty:
    print("Every outage has at least one feasible tested configuration.")
else:
    display(critical_lines)

voltage_cases = contingency_results[contingency_results.voltage_violation == True]
line_overload_cases = contingency_results[contingency_results.line_violation == True]
unsupplied_cases = contingency_results[contingency_results.unsupplied == True]

print("\n===== STEP 1.2 / 1.3 SUMMARY =====")
summary = {
    "Number of contingency lines": len(contingency_lines),
    "Number of switch configurations": len(switch_configs),
    "Total contingency cases": len(contingency_results),
    "Cases with violations": len(violation_cases),
    "Voltage violation cases": len(voltage_cases),
    "Line overload cases": len(line_overload_cases),
    "Unsupplied cases": len(unsupplied_cases),
    "Final critical lines": len(critical_lines),
}
for label, value in summary.items():
    print(f"{label}: {value}")

print("\n===== CRITICAL LINE NAMES =====")
for line_name in critical_lines.outage_line:
    print(f"- {line_name}")
