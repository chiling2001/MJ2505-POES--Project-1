#
# Base
# Config 1
# Config 2
# Config 3
#
# 全部都有问题，
# 则不存在可行 switching configuration。

critical_lines = line_summary[

    line_summary[
        "no_feasible_configuration"
    ] == True

].copy()


print(
    "\n===== FINAL CRITICAL LINES ====="
)


if critical_lines.empty:

