# CRITICAL LINE IDENTIFICATION
# ============================================================


# ============================================================
# 34. 找所有 Violation Cases
# ============================================================
#
# 一个 Violation Case 表示：
#
# 某条线路 outage
# +
# 某种 configuration
# +
# 出现运行问题

violation_cases = contingency_results[

    contingency_results[
        "any_violation"
    ] == True

].copy()



# ============================================================
# 35. 判断 Violation 原因
# ============================================================

def get_violation_reason(row):

    reasons = []


    if row[
        "unsupplied"
    ]:

        reasons.append(
            "Unsupplied bus"
        )


    if row[
        "voltage_violation"
    ]:

        reasons.append(
            "Voltage violation"
        )


    if row[
        "line_violation"
    ]:

        reasons.append(
            "Line overload"
        )


    return " + ".join(
        reasons
    )



violation_cases[
    "reason"
] = violation_cases.apply(

    get_violation_reason,

    axis=1
)



# ============================================================
# 36. 显示 Violation Cases
# ============================================================

print(
    "\n===== VIOLATION CASES AND REASONS ====="
)


display(
    violation_cases[
        [
            "configuration",
            "outage_line",
            "reason",
            "unsupplied_buses",
            "min_voltage_pu",
            "min_voltage_bus",
            "max_line_loading_percent",
            "max_loading_line"
        ]
    ].round(4)
)



# ============================================================
# 37. 每种 Configuration 下的 Violating Lines
# ============================================================

print(
    "\n===== VIOLATING LINES BY CONFIGURATION ====="
)


for config_name in switch_configs.keys():

    temp = violation_cases[

        violation_cases[
            "configuration"
        ] == config_name

    ]


    violating_lines = (

        temp[
            "outage_line"
        ]

        .drop_duplicates()

        .tolist()
    )


    print(
        f"\n--- {config_name} ---"
    )


    if len(
        violating_lines
    ) == 0:

        print(
            "No violating lines."
        )


    else:

        for line_name in violating_lines:

            print(
                "-",
                line_name
            )



# ============================================================
# 38. 汇总每一条 Outage Line
# ============================================================

line_summary_list = []


for line_index in contingency_lines:

    line_name = net.line.loc[
        line_index,
        "name"
    ]


    temp = contingency_results[

        contingency_results[
            "outage_line"
        ] == line_name

    ]


    # 出现问题的 configuration
    violating_configs = temp[

        temp[
            "any_violation"
        ] == True

    ][
        "configuration"
    ].tolist()


    # 可以正常运行的 configuration
    feasible_configs = temp[

        temp[
            "any_violation"
        ] == False

    ][
        "configuration"
    ].tolist()


    line_summary_list.append({

        "outage_line":
            line_name,

        "violating_configs":
            ", ".join(
                violating_configs
            ),

        "feasible_configs":
            ", ".join(
                feasible_configs
            ),

        "no_feasible_configuration":
            len(
                feasible_configs
            ) == 0
    })



line_summary = pd.DataFrame(
    line_summary_list
)


print(
    "\n===== LINE CONTINGENCY SUMMARY ====="
)


display(
    line_summary
)



