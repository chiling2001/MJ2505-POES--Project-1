# %%
import copy
import numpy as np
import pandas as pd
import pandapower as pp
import pandapower.networks as pn
import pulp as pl
from pathlib import Path
import matplotlib.pyplot as plt

## Section 0 – Setup and Configuration

# ---------- PATHS ----------
PROJECT_ROOT = Path.cwd()
if not (PROJECT_ROOT / "2_inputs").is_dir():
    PROJECT_ROOT = PROJECT_ROOT.parent

INPUT_DIR = PROJECT_ROOT / "2_inputs"
SCHEDULE_DIR = PROJECT_ROOT / "3_outputs" / "2_EVfleet"
OUTPUT_DIR = PROJECT_ROOT / "3_outputs"
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

# ---------- SIMULATION SETTINGS ----------
DEPOTS, N_DAYS, T = ["ICA", "Mathem", "PostNord", "Airmee"], 14, 24
START_DATE = "2026-08-01"
END_DATE = "2026-08-14"

# Keep the network mapping consistent with the previous steps.
depot_bus_map = {"ICA": 12, "PostNord": 1, "Mathem": 14, "Airmee": 8}

# Prices (SE2 → Aug 2026)
prices_df = pd.read_csv(INPUT_DIR / "nordpool_prices_SE2_2024.csv").rename(columns={
    "MTU (CET/CEST)": "date", "Day-ahead Price (SEK/kWh)": "price_SEK_per_kWh"})
prices_df["date"] = pd.to_datetime(prices_df["date"], format="%d/%m/%y %H:%M:%S", dayfirst=True)
prices_df = prices_df.set_index("date").sort_index()
prices_df.index = pd.date_range(START_DATE, periods=len(prices_df), freq="h")
prices_df = prices_df.loc[START_DATE:END_DATE]

# Schedules (Jan CSV → Aug labels, positional)
def load_schedule(d):
    schedule_path = SCHEDULE_DIR / f"schedule_{d}" / f"schedule_{d}.csv"
    if not schedule_path.exists():
        raise FileNotFoundError(f"Schedule file not found: {schedule_path}")
    df = pd.read_csv(schedule_path)
    df["date"] = pd.to_datetime(df["date"])
    df = df.rename(columns={"Consumption_kWh": "kwh", "ChargingStation": "avail", "PowerRating_kW": "kw"})
    h = df.groupby("date").agg(kwh=("kwh","sum"), avail=("avail","max"), kw=("kw","sum")).sort_index()
    h.index = prices_df.index[:len(h)]
    return h

schedules = {d: load_schedule(d) for d in DEPOTS}
for d in DEPOTS:
    schedules[d]["avail"] = schedules[d]["avail"].clip(0, 1)

# Base profiles
fp = pd.read_excel(INPUT_DIR / "Load_profiles_Freight transports.xlsx",
                   sheet_name="Load_profiles_Freight transport")
fp = fp.rename(columns={c: {"ica":"ICA","mathem":"Mathem","postnord":"PostNord","airmee":"Airmee"}
                          .get(c.strip().lower(), c) for c in fp.columns})
fp = fp.iloc[:len(prices_df)].reset_index(drop=True)
for d in DEPOTS:
    if d not in fp.columns: fp[d] = 0.0

# Network
net_base = pn.create_cigre_network_mv(with_der=False)
net_base.load[["p_mw","q_mvar"]] /= 2
net_base.switch["closed"] = True
depot_load_idx = {d: pp.create_load(net_base, bus=depot_bus_map[d],
                                     p_mw=0.0, q_mvar=0.0, name=f"depot_{d}") for d in DEPOTS}

# Time-series helper (returns losses too)
def run_ts(charge_dict):
    ti = prices_df.index
    vm = pd.DataFrame(index=ti, columns=net_base.bus.index, dtype=float)
    load = pd.DataFrame(index=ti, columns=net_base.line.index, dtype=float)
    trafo = pd.DataFrame(index=ti, columns=net_base.trafo.index, dtype=float)
    loss = pd.Series(index=ti, dtype=float)
    loss_lines = pd.DataFrame(index=ti, columns=net_base.line.index, dtype=float)
    net = copy.deepcopy(net_base)
    ev = {d: pp.create_load(net, bus=depot_bus_map[d], p_mw=0, q_mvar=0) for d in DEPOTS}
    for i, t in enumerate(ti):
        for d in DEPOTS:
            net.load.at[depot_load_idx[d], "p_mw"] = float(fp[d].iloc[i]) / 1000.0
            net.load.at[ev[d], "p_mw"] = float(charge_dict[d][i]) / 1000.0
        pp.runpp(net, verbose=False)
        vm.loc[t] = net.res_bus["vm_pu"].values
        load.loc[t] = net.res_line["loading_percent"].values
        trafo.loc[t] = net.res_trafo["loading_percent"].values
        loss_lines.loc[t] = net.res_line["pl_mw"].values
        loss.loc[t] = net.res_line["pl_mw"].sum() + net.res_trafo["pl_mw"].sum()
    return vm, load, trafo, loss, loss_lines

print(f"Prices {len(prices_df)}h | schedules & profiles loaded")

# %%
## Step 5.1 – Network-Aware Smart Charging Optimisation

# Marginal Loss Factors: MW-loss increase per MW injected at each depot/hour
mlf = pd.DataFrame(index=prices_df.index, columns=DEPOTS, dtype=float)
for i, t in enumerate(prices_df.index):
    nb = copy.deepcopy(net_base)
    for d in DEPOTS:
        nb.load.at[depot_load_idx[d], "p_mw"] = float(fp[d].iloc[i]) / 1000.0
    pp.runpp(nb, verbose=False)
    base = nb.res_line["pl_mw"].sum() + nb.res_trafo["pl_mw"].sum()
    for d, bus in depot_bus_map.items():
        np_ = copy.deepcopy(nb)
        pp.create_load(np_, bus=bus, p_mw=1.0, q_mvar=0.0)
        pp.runpp(np_, verbose=False)
        mlf.loc[t, d] = (np_.res_line["pl_mw"].sum() + np_.res_trafo["pl_mw"].sum()) - base
print(f"MLF range: {mlf.values.min():.4f} – {mlf.values.max():.4f} MW/MW\n")

# Unified LP — mode 'cost' or 'loss'
def optimise_day(day, prices_day, mlf_day, dd, mode):
    m = pl.LpProblem(f"{mode}_{day}", pl.LpMinimize)
    ch = {d: pl.LpVariable.dicts(f"c_{d}", range(T), lowBound=0) for d in DEPOTS}
    ce = {d: pl.LpVariable.dicts(f"e_{d}", range(T), lowBound=0) for d in DEPOTS}
    for d in DEPOTS:
        for t in range(T):
            m += ch[d][t] <= dd[d]["kw"].iloc[t] * dd[d]["avail"].iloc[t]
            m += ce[d][t] == (ch[d][t] if t == 0 else ce[d][t - 1] + ch[d][t])
        ai = [t for t in range(T) if dd[d]["avail"].iloc[t] == 1]
        if ai:
            m += ce[d][max(ai)] == dd[d]["kwh"]
    obj = (
        pl.lpSum(ch[d][t] * prices_day.iloc[t] for d in DEPOTS for t in range(T))
        if mode == "cost"
        else pl.lpSum(ch[d][t] * mlf_day[d].iloc[t] for d in DEPOTS for t in range(T))
    )
    m += obj
    m.solve(pl.PULP_CBC_CMD(msg=False))
    return ({d: [ch[d][t].varValue for t in range(T)] for d in DEPOTS} if pl.LpStatus[m.status] == "Optimal" else None)


# %%
## Step 5.2 – Strategy Generation and Time-Series Simulation

# Uncontrolled: charge ASAP at max power until daily need met
def unc_day(avail, kw, need):
    out, rem = [0.0] * T, need
    for t in range(T):
        if avail.iloc[t] == 1 and rem > 0:
            p = min(kw.iloc[t], rem)
            out[t] = p
            rem -= p
            if rem <= 0:
                break
    return out

profiles = {mode: {d: [] for d in DEPOTS} for mode in ["unc", "cost", "loss"]}

for day in range(N_DAYS):
    s, e = day * T, (day + 1) * T
    if e > len(prices_df):
        break
    prices_day = prices_df["price_SEK_per_kWh"].iloc[s:e].reset_index(drop=True)
    mlf_day = mlf.iloc[s:e].reset_index(drop=True)
    dd = {
        d: {
            "avail": schedules[d]["avail"].iloc[s:e].reset_index(drop=True),
            "kw": schedules[d]["kw"].iloc[s:e].reset_index(drop=True),
            "kwh": schedules[d]["kwh"].iloc[s:e].sum(),
        }
        for d in DEPOTS
    }
    for d in DEPOTS:
        profiles["unc"][d].extend(unc_day(dd[d]["avail"], dd[d]["kw"], dd[d]["kwh"]))
    for mode in ["cost", "loss"]:
        p = optimise_day(day, prices_day, mlf_day, dd, mode)
        if p:
            for d in DEPOTS:
                profiles[mode][d].extend(p[d])
    print(f"Day {day + 1:2d} done")

# Time-series for all three
print("\nRunning time-series...")
vm_u, l_u, t_u, loss_u, ll_u = run_ts(profiles["unc"])
vm_c, l_c, t_c, loss_c, ll_c = run_ts(profiles["cost"])
vm_l, l_l, t_l, loss_l, ll_l = run_ts(profiles["loss"])

# N-1 at each strategy's worst hour
def n1(net_base, charge_dict, trafo_df):
    iw = trafo_df.max(axis=1).idxmax()
    i = trafo_df.index.get_loc(iw)
    net = copy.deepcopy(net_base)
    ev = {d: pp.create_load(net, bus=depot_bus_map[d], p_mw=0, q_mvar=0) for d in DEPOTS}
    for d in DEPOTS:
        net.load.at[depot_load_idx[d], "p_mw"] = float(fp[d].iloc[i]) / 1000
        net.load.at[ev[d], "p_mw"] = float(charge_dict[d][i]) / 1000
    pp.runpp(net, verbose=False)
    viol = []
    for lo in [l for l in net.line.index if l not in [12, 13, 14]]:
        net.line.at[lo, "in_service"] = False
        try:
            pp.runpp(net, verbose=False)
            if (
                net.res_bus["vm_pu"].min() < 0.9
                or net.res_bus["vm_pu"].max() > 1.1
                or net.res_line["loading_percent"].max() > 100
                or net.res_trafo["loading_percent"].max() > 100
            ):
                viol.append(lo)
        except Exception:
            viol.append(lo)
        finally:
            net.line.at[lo, "in_service"] = True
    return iw, viol

w_u, v_u = n1(net_base, profiles["unc"], t_u)
w_c, v_c = n1(net_base, profiles["cost"], t_c)
w_l, v_l = n1(net_base, profiles["loss"], t_l)
print(f"N-1 viol lines — unc {v_u}, cost-opt {v_c}, loss-opt {v_l}")


# %%
## Step 5.3 – Results Summary and Strategy Comparison

# Costs and loss stats
def cost(p):
    return sum(p[d][i] * prices_df["price_SEK_per_kWh"].iloc[i] for d in DEPOTS for i in range(len(p[d])))

delivered = sum(sum(profiles["loss"][d]) for d in DEPOTS)
c_u, c_c, c_l = cost(profiles["unc"]), cost(profiles["cost"]), cost(profiles["loss"])
lu, lc, ll = loss_u.sum() * 1000, loss_c.sum() * 1000, loss_l.sum() * 1000

comp = pd.DataFrame({
    "Metric": ["Cost (SEK)", "Avg price (SEK/kWh)", "Losses (kWh, 2w)", "Losses (%)",
               "Max trafo (%)", "Max line (%)", "Min V (pu)", "N-1 violating outages", "Critical lines"],
    "Uncontrolled": [f"{c_u:.0f}", f"{c_u / delivered:.4f}", f"{lu:.0f}", f"{100 * lu / delivered:.2f}%",
                     f"{t_u.max().max():.1f}", f"{l_u.max().max():.1f}", f"{vm_u.min().min():.4f}",
                     len(v_u), str(v_u)],
    "Cost-opt (S4)": [f"{c_c:.0f}", f"{c_c / delivered:.4f}", f"{lc:.0f}", f"{100 * lc / delivered:.2f}%",
                      f"{t_c.max().max():.1f}", f"{l_c.max().max():.1f}", f"{vm_c.min().min():.4f}",
                      len(v_c), str(v_c)],
    "Loss-opt (S5)": [f"{c_l:.0f}", f"{c_l / delivered:.4f}", f"{ll:.0f}", f"{100 * ll / delivered:.2f}%",
                      f"{t_l.max().max():.1f}", f"{l_l.max().max():.1f}", f"{vm_l.min().min():.4f}",
                      len(v_l), str(v_l)],
})
display(comp)
comp.to_csv(OUTPUT_DIR / "step5_three_way_comparison.csv", index=False)

print(f"\nLoss reduction vs uncontrolled: {lu - ll:.0f} kWh ({100 * (lu - ll) / lu:.1f}%)")
print(f"Loss reduction vs cost-opt    : {lc - ll:.0f} kWh ({100 * (lc - ll) / lc:.1f}%)")
print(f"Cost premium vs cost-opt      : {c_l - c_c:+.0f} SEK ({100 * (c_l - c_c) / c_c:+.1f}%)")
print(f"\nLoss concentration (loss-opt, top 5 lines):")
print(ll_l.sum().sort_values(ascending=False).head(5).to_string())

# Plot
fig, ax = plt.subplots(3, 1, figsize=(14, 9), sharex=True)
x = prices_df.index
for m, col, lbl in [("unc", "red", "Uncontrolled"), ("cost", "steelblue", "Cost-opt"), ("loss", "green", "Loss-opt")]:
    tot = [sum(profiles[m][d][i] for d in DEPOTS) for i in range(len(x))]
    ax[0].plot(x, tot, color=col, alpha=0.8, label=lbl)
    ax[1].plot(x, (loss_u if m == "unc" else loss_c if m == "cost" else loss_l) * 1000, color=col, alpha=0.8, label=lbl)
    ax[2].plot(x, (t_u if m == "unc" else t_c if m == "cost" else t_l).max(axis=1), color=col, alpha=0.8, label=lbl)
ax[0].set_ylabel("EV charging (kW)")
ax[0].legend(); ax[0].grid(alpha=0.3)
ax[1].set_ylabel("Losses (kWh/h)")
ax[1].legend(); ax[1].grid(alpha=0.3)
ax[2].set_ylabel("Trafo loading (%)")
ax[2].axhline(100, color="grey", linestyle=":")
ax[2].set_xlabel("Time")
ax[2].legend(); ax[2].grid(alpha=0.3)
plt.tight_layout()
plt.savefig(OUTPUT_DIR / "step5_strategy_comparison.png", dpi=150)
plt.show()



